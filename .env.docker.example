# ==========================================
# Variáveis de Ambiente para Stack Portainer / Docker
# ==========================================

# Banco de Dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_uma_senha_muito_segura_aqui
POSTGRES_DB=itmizer_vr

# Portas de Acesso no Host (Servidor / VPS)
BACKEND_PORT=3000
FRONTEND_PORT=8080

# Autenticação JWT
JWT_SECRET=gere_uma_chave_secreta_longa_e_aleatoria
JWT_EXPIRES_IN=1d

# Chave Criptográfica AES-256-GCM para Vault de Senhas de Clientes (32 bytes base64)
# Exemplo gerado via terminal: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=defina_chave_32_bytes_base64_aqui

# Endpoint da API no Frontend
# No ambiente de produção, aponte para o domínio público do Backend (ex: https://api.seudominio.com.br)
VITE_API_URL=http://localhost:3000
