# ==========================================
# Variáveis de Ambiente para Stack Completa Portainer / Docker
# ==========================================

# Banco de Dados PostgreSQL (PostgreSQL 17 Alpine)
POSTGRES_USER=itmizer_admin
POSTGRES_PASSWORD=defina_uma_senha_muito_segura_aqui
POSTGRES_DB=itmizer_vr

# Portas de Acesso no Host (Servidor / VPS)
BACKEND_PORT=3000
FRONTEND_PORT=3009

# Autenticação JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Chave Criptográfica AES-256-GCM para Vault de Senhas de Clientes (32 bytes base64)
# Exemplo gerado via terminal: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=S87YqZ4p7eKx2fL9pQW1mR5tU8vX4zB3nC6vM9qE2wA=

# Endpoint da API no Frontend (/api é roteado internamente pelo Nginx)
VITE_API_URL=/api

# ==========================================
# Integração Google Drive (Backups em Nuvem)
# ==========================================
# ID da pasta de destino: https://drive.google.com/drive/folders/0AAzNdB7t26iUUk9PVA
GOOGLE_DRIVE_FOLDER_ID=0AAzNdB7t26iUUk9PVA

# Credenciais da Service Account do Google Cloud (GCP)
# Opção A: Email da Service Account + Chave Privada RSA
GOOGLE_SERVICE_ACCOUNT_EMAIL=seu-backup-sa@seu-projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"

# Opção B (Alternativa): JSON completo da Service Account (string JSON ou Base64)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
