# ==========================================
# Variáveis de Ambiente para Stack Portainer / Docker
# ==========================================

# Banco de Dados PostgreSQL Externo (ex: Prisma Platform, Supabase, Neon, AWS RDS, etc.)
DATABASE_URL=postgres://usuario:senha@db.prisma.io:5432/postgres?sslmode=require&pool=true
DIRECT_URL=postgres://usuario:senha@db.prisma.io:5432/postgres?sslmode=require&pool=true

# Portas de Acesso no Host (Servidor / VPS)
BACKEND_PORT=3000
FRONTEND_PORT=3009

# Autenticação JWT
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRES_IN=1d

# Chave Criptográfica AES-256-GCM para Vault de Senhas de Clientes (32 bytes base64)
# Exemplo gerado via terminal: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=S87YqZ4p7eKx2fL9pQW1mR5tU8vX4zB3nC6vM9qE2wA=

# Endpoint da API no Frontend (/api é roteado internamente pelo Nginx)
VITE_API_URL=/api

