# Configuração do Banco de Dados - Supabase
# O caractere # na senha deve ser codificado como %23 na URL
DATABASE_URL="postgresql://postgres:SUA_SENHA%23SUFIXO@db.SEU_PROJECT_REF.supabase.co:5432/postgres"

# URL direta para migrations Prisma (sem pooler)
# Pode ser igual ao DATABASE_URL se não usar PgBouncer
DIRECT_URL="postgresql://postgres:SUA_SENHA%23SUFIXO@db.SEU_PROJECT_REF.supabase.co:5432/postgres"

# Configuração JWT (Autenticação)
# IMPORTANTE: Troque por um secret forte em produção!
JWT_SECRET="troque-por-um-secret-forte-em-producao"
JWT_EXPIRES_IN="1d"

# Porta do servidor (Vercel define automaticamente)
PORT=3000
